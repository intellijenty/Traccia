{
  "appId": "in.yashpz.traccia",
  "productName": "Traccia",
  "files": [
    "dist-react/**/*",
    "dist-electron/**/*",
    "!node_modules/better-sqlite3/prebuilds/{darwin,linux}*"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": "."
    }
  ],
  "icon": "./resources/desktopIcon.png",
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": true,
    "allowToChangeInstallationDirectory": false
  },
  "publish": [
    {
      "provider": "github",
      "owner": "intellijenty",
      "repo": "Traccia"
    }
  ]
}